# --- HTTP / MCP transport (Phase 1: local network) ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# Optional bearer token. When set, requests must send
# `Authorization: Bearer <token>` or append `?token=<token>` to the URL.
# Leave empty for an unauthenticated server (LAN-only use).
API_TOKEN=

# --- Index / Sync ---
DB_PATH=./data/index.db
SYNC_INTERVAL=900            # seconds between sync runs
INDEX_ATTACHMENTS=true
MAX_ATTACHMENT_BYTES=26214400   # 25 MB; larger attachments are not extracted
EXCLUDED_FOLDERS=Trash,Spam,Junk

# --- Accounts ---
# Multiple accounts: ACCOUNTS=primary,secondary with one block per account.
ACCOUNTS=primary

ACCOUNT_PRIMARY_HOST=imap.example.com
ACCOUNT_PRIMARY_PORT=993
ACCOUNT_PRIMARY_SSL=true
ACCOUNT_PRIMARY_USER=mailbox@example.com
ACCOUNT_PRIMARY_PASSWORD=changeme
# Optional: From header for drafts created via create_draft.
# Defaults to the login user, which must then be an e-mail address.
# ACCOUNT_PRIMARY_FROM=Jane Doe <mailbox@example.com>
# Optional: only sync these folders for this account (comma-separated).
# When empty, all selectable folders minus EXCLUDED_FOLDERS are indexed.
# An entry starting with "\" matches a SPECIAL-USE flag instead of a name.
# ACCOUNT_PRIMARY_FOLDERS=INBOX,Archive

# Example second account (also set ACCOUNTS=primary,secondary):
# ACCOUNT_SECONDARY_HOST=imap.example.com
# ACCOUNT_SECONDARY_PORT=993
# ACCOUNT_SECONDARY_SSL=true
# ACCOUNT_SECONDARY_USER=other@example.com
# ACCOUNT_SECONDARY_PASSWORD=changeme

# Gmail: use an app password (requires 2-step verification); the account
# password will not work over IMAP. Index only the All-Mail folder so that
# messages are not duplicated across INBOX and label folders. "\All" matches
# it via SPECIAL-USE flag, independent of its localized name
# ("[Gmail]/All Mail" vs "[Google Mail]/Alle Nachrichten").
# ACCOUNT_GMAIL_HOST=imap.gmail.com
# ACCOUNT_GMAIL_PORT=993
# ACCOUNT_GMAIL_SSL=true
# ACCOUNT_GMAIL_USER=you@gmail.com
# ACCOUNT_GMAIL_PASSWORD=your-16-char-app-password
# ACCOUNT_GMAIL_FOLDERS=\All
