# --- HTTP / MCP transport (Phase 1: nur Heimnetz) ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# --- Index / Sync ---
DB_PATH=./data/index.db
SYNC_INTERVAL=900            # Sekunden zwischen Sync-Läufen
INDEX_ATTACHMENTS=true
MAX_ATTACHMENT_BYTES=26214400   # 25 MB; größere Anhänge werden nicht extrahiert
EXCLUDED_FOLDERS=Trash,Spam,Junk

# --- Accounts ---
# Mehrere Accounts: ACCOUNTS=privat,arbeit  und je Account ein Block mit Prefix.
ACCOUNTS=privat

ACCOUNT_PRIVAT_HOST=imap.example.com
ACCOUNT_PRIVAT_PORT=993
ACCOUNT_PRIVAT_SSL=true
ACCOUNT_PRIVAT_USER=postfach@example.com
ACCOUNT_PRIVAT_PASSWORD=changeme

# Beispiel zweiter Account (ACCOUNTS=privat,arbeit setzen):
# ACCOUNT_ARBEIT_HOST=imap.example.com
# ACCOUNT_ARBEIT_PORT=993
# ACCOUNT_ARBEIT_SSL=true
# ACCOUNT_ARBEIT_USER=arbeit@example.com
# ACCOUNT_ARBEIT_PASSWORD=changeme
