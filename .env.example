# --- HTTP / MCP transport (Phase 1: local network) ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# Optional bearer token. When set, requests must send
# `Authorization: Bearer <token>` or append `?token=<token>` to the URL.
# Leave empty for an unauthenticated server (LAN-only use).
API_TOKEN=

# --- Index / Sync ---
DB_PATH=./data/index.db
SYNC_INTERVAL=900            # seconds between sync runs
INDEX_ATTACHMENTS=true
MAX_ATTACHMENT_BYTES=26214400   # 25 MB; larger attachments are not extracted
EXCLUDED_FOLDERS=Trash,Spam,Junk

# --- Accounts ---
# Multiple accounts: ACCOUNTS=primary,secondary with one block per account.
ACCOUNTS=primary

ACCOUNT_PRIMARY_HOST=imap.example.com
ACCOUNT_PRIMARY_PORT=993
ACCOUNT_PRIMARY_SSL=true
ACCOUNT_PRIMARY_USER=mailbox@example.com
ACCOUNT_PRIMARY_PASSWORD=changeme

# Example second account (also set ACCOUNTS=primary,secondary):
# ACCOUNT_SECONDARY_HOST=imap.example.com
# ACCOUNT_SECONDARY_PORT=993
# ACCOUNT_SECONDARY_SSL=true
# ACCOUNT_SECONDARY_USER=other@example.com
# ACCOUNT_SECONDARY_PASSWORD=changeme
